@{
	ViewData["Title"] = "registratiepagina";
	Layout = "~/Views/Shared/_MinimalLayout.cshtml";
}

<div class="d-flex flex-column mx-auto row col-lg-4 col-md-2 gap-3">
	<h3 class="text-center">Registratiepagina</h3>
	<form action="/registratie/submit" method="post">
		<div class="mb-3">
			<label class="form-label" for="nameInput">Gebruikersnaam</label>
			<input class="form-control" id="nameInput" name="userName" value="@ViewBag.EnteredUsername" placeholder="Geen spaties, begin met een hoofdletter." required />
			<span class="text-danger form-text d-block">@Html.ValidationMessage("userName")</span>
			<span class="form-text d-block"></span>
		</div>
		<div class="mb-3">
			<label class="form-label" for="nameInput">Wachtwoord</label>
			<input class="form-control" id="nameInput" type="password" name="password" required />
			<span class="form-text text-danger">@Html.ValidationMessage("passWord")</span>
		</div>
		<div class="mb-3 alig-items-end d-flex justify-content-end">
			<button class="btn btn-primary" type="submit">Registreer</button>
		</div>
		<div class="mb-3 d-flex justify-content-center">
			<span class="form-text text-success">@Html.ValidationMessage("registrationFinished")</span>
		</div>
	</form>
</div>
