@model overzichtPaginaViewModel
@{
	ViewData["Title"] = "Overzichtpagina";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="text-center d-flex flex-column gap-3">
	<span class="h3">Tafelnummer: @Model.TableNumber</span>
	<span class="fw-bold">Overzicht</span>
	<table class="table">
		<tr>
			<th>Product</th>
			<th>Eenheidsprijs</th>
			<th>Aantal</th>
			<th>Subtotaal</th>
		</tr>
		@foreach (var productProperties in Model.OrderedProductProperties!)
		{
			<tr>
				<td>@productProperties.ProductName</td>
				<td>€ @productProperties.UnitPrice.ToString("F2")</td>
				<td>@productProperties.Amount</td>
				<td>€ @productProperties.SubtotalPrice.ToString("F2")</td>
			</tr>
		}
		<tr>
			<th>Totaalbedrag:</th>
			<td></td>
			<td></td>
			<th>€ @Model.TotalPrice.ToString("F2")</th>
		</tr>
	</table>
</div>
<form action="/bestel/betaling" method="post">
	<input type="hidden" name="totalPrice" value="@Model.TotalPrice" />
	@for (int i = 0; i < Model.OrderedProductProperties.Count(); i++)
	{
		<input type="hidden" name="orderedProductProperties[@i].ProductID" value="@Model.OrderedProductProperties[i].ProductID"/>
		<input type="hidden" name="orderedProductProperties[@i].Amount" value="@Model.OrderedProductProperties[i].Amount" />
	}
	<button class="btn btn-primary btn-lg text-center fixed-bottom" type="submit">Afrekenen</button>
</form>
<script src="~/js/overzichtPagina.js"></script>
