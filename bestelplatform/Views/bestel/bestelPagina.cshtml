@model bestelPaginaViewModel
@{
	ViewData["Title"] = "Bestel Pagina";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="text-center">
	<span class="h3">Tafelnummer: @Model.TableNumber</span>
	<div id="alert-container" class="m-3"></div>
	<form action="/bestel/overzicht" method="post" onsubmit="return validateOrder()">
		<div class="container text-center user-select-none"></div>
		<div class="row row-cols-1 row-cols-md-2 border gy-3 pb-3 my-3">
			@{
				var productTypes = Model.ProductDetails.Select(row => row.ProductType).Distinct().OrderBy(x => x).ToList();
			}
			@foreach (var type in productTypes)
			{
				<div class="col col-lg-12 text-decoration-underline h4 text-start text-capitalize">@type.ToString().Replace("_", " ")</div>
				@for (int i = 0; i < Model.ProductDetails.Count; i++)
				{
					if (Model.ProductDetails[i].ProductType == type)
					{
						var productdetail = Model.ProductDetails[i];
						var productName = productdetail.ProductName;
						var databaseID = productdetail.ProductID;
						var productPrice = productdetail.ProductPrice;
						var uniqueID = productName.Replace(" ", "");
						<div class="col">
							<div class="d-flex gap-3 justify-content-between">
								<div class="d-flex gap-3 align-items-center">
									<span>@productName</span>
									<span>€ @productPrice.ToString("F2")</span>
									<i class="bi bi-dash-circle fs-2 text-danger" role="button" name="subtract" onclick="changeProductAmount('@uniqueID', -1)"></i>
									<i class="bi bi-plus-circle fs-2 text-success" role="button" name="add" onclick="changeProductAmount('@uniqueID', 1)"></i>
								</div>
								<input type="hidden" name="bestelInputs[@i].InputID" value="@databaseID" />
								<input type="hidden" name="bestelInputs[@i].ProductName" value="@productName" />
								<input class="form-control" style="width:80px; display:inline-block" id="amount-@uniqueID" value="0" name="bestelInputs[@i].Amount" min="0" type="number" oninput="this.value = Math.abs(this.value)">
							</div>
						</div>
					}
				}
			}
		</div>
		<button class="btn btn-primary btn-lg text-center fixed-bottom" type="submit">bestel</button>
	</form>
</div>
<script src="~/js/bestelPagina.js"></script>
